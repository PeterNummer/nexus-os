
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thyqora-os",
  "main": "src/index.js",
  "compatibility_date": "2026-11-13",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexus-os-db",
      "database_id": "c516563c-f116-4e44-ae7d-11c6e3c3575c"
    }
  ],

  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    }
  }
}
