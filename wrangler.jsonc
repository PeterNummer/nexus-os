
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexus-os",
  "main": "src/index.js",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexus-os-db",
      "database_id": "DEINE_DATABASE_ID"
    }
  ]
}
